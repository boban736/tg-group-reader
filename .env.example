# https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# @username, -100... id или точное название чата
TG_GROUP=IA FR 2503 RU

OPENAI_API_KEY=sk-...
# точный id модели из документации OpenAI (GPT-6 Luna = gpt-6-luna)
OPENAI_MODEL=gpt-6-luna
# none|low|medium|high; пусто = по умолчанию модели
OPENAI_REASONING=low
# OPENAI_BASE_URL=   # если используешь прокси/совместимый API

# Obsidian (раскладка под vault USM, см. AGENTS.md в vault)
VAULT_DIR="~/Library/Mobile Documents/iCloud~md~obsidian/Documents/USM"
VAULT_DIGEST_SUBDIR=Log/Telegram
VAULT_LOG_SUBDIR=Log
VAULT_COURSES_SUBDIR=Courses
VAULT_INBOX_ATTACH_SUBDIR=Inbox/Telegram
VAULT_DEADLINES_NOTE=Дедлайны.md
COURSE_ATTACH_SUBDIR=Materials/Telegram
COURSE_SECTION="## Из Telegram"
NOTE_TAGS=telegram
# что дописывать в существующие заметки
WRITE_LOG=1
WRITE_DEADLINES=1
WRITE_COURSE_SECTIONS=1
# категории, для которых фото/файлы сохраняются в vault
SAVE_FILES_FOR=deadline,material,schedule,announcement

# Уведомления о срочном в «Избранное»
NOTIFY_URGENT=1
NOTIFY_TARGET=me

# Лимиты
FIRST_RUN_HOURS=24
MAX_MESSAGES=500
BATCH_MESSAGES=150
BATCH_IMAGES=10
MAX_FILE_MB=20
DOC_TEXT_CHARS=12000
IMAGE_DETAIL=high
