# https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# @username, -100... id или точное название чата
TG_GROUP=IA FR 2503 RU

OPENAI_API_KEY=sk-...
# точный id модели из документации OpenAI
OPENAI_MODEL=
# OPENAI_BASE_URL=   # если используешь прокси/совместимый API

# Obsidian
VAULT_DIR=~/Documents/Obsidian/MyVault
VAULT_NOTES_SUBDIR=Универ/Дайджест
VAULT_ATTACH_SUBDIR=Универ/Дайджест/files
NOTE_TAGS=универ,дайджест
SUBJECT_LINKS=1
# категории, для которых фото/файлы сохраняются в vault
SAVE_FILES_FOR=deadline,material,schedule,announcement

# Уведомления о срочном в «Избранное»
NOTIFY_URGENT=1
NOTIFY_TARGET=me

# Лимиты
FIRST_RUN_HOURS=24
MAX_MESSAGES=500
BATCH_MESSAGES=150
BATCH_IMAGES=10
MAX_FILE_MB=20
DOC_TEXT_CHARS=12000
IMAGE_DETAIL=high
